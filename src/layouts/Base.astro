---
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { url } from '../lib/urls';
const { title = 'Brewster Smyers | Mechanical Engineering', description = 'Mechanical engineering student at Bucknell University. Selected work in mechanical design, manufacturing, aircraft analysis and fluid mechanics.' } = Astro.props;
const current = Astro.url.pathname;
const nav = [['Projects','projects/'],['Coursework','coursework/'],['About','about/'],['Resume','resume/'],['Contact','contact/']];
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#182d3b"/><title>{title}</title><link rel="icon" href={url('favicon.svg')} type="image/svg+xml"/></head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header wrap"><a class="brand" href={url()} aria-label="Brewster Smyers home"><span class="monogram" aria-hidden="true">BS<span>.</span></span><span>Brewster Smyers<small>Mechanical Engineering</small></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav">Menu <span aria-hidden="true">+</span></button><nav id="primary-nav" aria-label="Main navigation">{nav.map(([label,path])=><a href={url(path)} aria-current={current.startsWith(url(path)) ? 'page' : undefined}>{label}</a>)}</nav></header>
<main id="main"><slot/></main>
<footer class="site-footer wrap"><div><a class="footer-name" href={url()}>Brewster Smyers<span>.</span></a><p>Mechanical engineering, from model to making.</p></div><div><a href={url('contact/')}>Let’s connect <span aria-hidden="true">↗</span></a><small>Bucknell University · Class of 2028</small></div></footer>
<script>const button=document.querySelector('.menu-toggle');const nav=document.getElementById('primary-nav');button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('is-open',!open)});document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&button?.getAttribute('aria-expanded')==='true'){button.setAttribute('aria-expanded','false');nav?.classList.remove('is-open');button.focus()}});</script>
</body></html>
