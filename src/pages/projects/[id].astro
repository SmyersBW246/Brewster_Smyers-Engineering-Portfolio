---
// One project page. Astro builds a copy of this page for every file in src/content/projects.
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/urls';

// Tells Astro which pages to build: one per project, at /projects/<file name>/.
export async function getStaticPaths() {
  return (await getCollection('projects', (p) => !p.data.hidden)).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);

// Courses listed in this project's "courses" field, shown as links at the bottom.
const all = await getCollection('coursework');
const related = all.filter((c) => p.courses.includes(c.id));
---
<Base title={`${p.shortTitle} | Brewster Smyers`} description={p.summary}>
  {/* Title, summary and the role / tools / status row */}
  <section class="project-heading wrap">
    <a class="back-link" href={url('projects/')}>← All projects</a>
    <p class="eyebrow">{p.category} / {p.period}</p>
    <h1>{p.title}<span>.</span></h1>
    <p class="lead">{p.summary}</p>
    <div class="project-details">
      <div>
        <small>My role</small>
        <p>{p.role}</p>
      </div>
      <div>
        <small>Methods + tools</small>
        <p>{p.tools.join(' / ')}</p>
      </div>
      <div>
        <small>Project status</small>
        <p>{p.status}</p>
      </div>
    </div>
  </section>

  {/* Main image, only when the project has one */}
  {p.heroGallery?.length ? (
    <figure class="project-hero wrap">
      <div class="hero-collage">
        {p.heroGallery.map((g) => (
          <a href={url(g.src)} aria-label={`Open full size: ${g.alt}`}>
            <img src={url(g.src)} alt={g.alt} width="900" height="640" fetchpriority="high"/>
          </a>
        ))}
      </div>
      <figcaption>{p.heroCaption}</figcaption>
    </figure>
  ) : p.hero && (
    <figure class="project-hero wrap">
      <img src={url(p.hero)} alt={p.heroAlt} width="1600" height="1100" fetchpriority="high"/>
      <figcaption>{p.heroCaption}</figcaption>
    </figure>
  )}

  {/* Facts column on the left, the written case study on the right */}
  <section class="case-study wrap">
    <aside>
      <p class="eyebrow">At a glance</p>
      {p.facts.map((f) => (
        <div class="fact">
          <strong>{f.value}</strong>
          <span>{f.label}</span>
        </div>
      ))}
      {p.document && <a class="button small" href={url(p.document)}>Project brief <span aria-hidden="true">↓</span></a>}
    </aside>
    <article class="prose">
      <Content/>
    </article>
  </section>

  {/* Figure gallery, only when the project lists figures */}
  {p.figures.length > 0 && (
    <section class="evidence wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Evidence, up close</p>
          <h2>Figures.</h2>
        </div>
      </div>
      <div class="figure-grid">
        {p.figures.map((f) => (
          <figure>
            <a href={url(f.src)} aria-label={`Open full size: ${f.alt}`}>
              <img src={url(f.src)} alt={f.alt} width="1200" height="900" loading="lazy"/>
            </a>
            <figcaption>{f.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {/* Links to related course notes */}
  {related.length > 0 && (
    <section class="related wrap">
      <p class="eyebrow">Connected coursework</p>
      {/* Only featured courses have their own page; the rest link to the coursework list. */}
      {related.map((c) => c.data.tier === 'featured' ? (
        <a class="related-link" href={url(`coursework/${c.id}/`)}><span>{c.data.code}</span>{c.data.title}<b aria-hidden="true">↗</b></a>
      ) : (
        <a class="related-link" href={url('coursework/')}><span>{c.data.code}</span>{c.data.title}<b aria-hidden="true">↗</b></a>
      ))}
    </section>
  )}
</Base>
