---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';import {url} from '../../lib/urls';
export async function getStaticPaths(){return (await getCollection('projects')).map(project=>({params:{id:project.id},props:{project}}))}
const {project}=Astro.props;const p=project.data;const {Content}=await render(project);const all=await getCollection('coursework');const related=all.filter(c=>p.courses.includes(c.id));
---
<Base title={`${p.shortTitle} | Brewster Smyers`} description={p.summary}><section class="project-heading wrap"><a class="back-link" href={url('projects/')}>← All projects</a><p class="eyebrow">{p.category} / {p.period}</p><h1>{p.title}<span>.</span></h1><p class="lead">{p.summary}</p><div class="project-details"><div><small>My role</small><p>{p.role}</p></div><div><small>Methods + tools</small><p>{p.tools.join(' / ')}</p></div><div><small>Project status</small><p>{p.status}</p></div></div></section>{p.hero&&<figure class="project-hero wrap"><img src={url(p.hero)} alt={p.heroAlt} width="1600" height="1100" fetchpriority="high"/><figcaption>{p.heroCaption}</figcaption></figure>}<section class="case-study wrap"><aside><p class="eyebrow">At a glance</p>{p.facts.map(f=><div class="fact"><strong>{f.value}</strong><span>{f.label}</span></div>)}{p.document&&<a class="button small" href={url(p.document)}>Project brief <span aria-hidden="true">↓</span></a>}</aside><article class="prose"><Content/></article></section>{p.figures.length>0&&<section class="evidence wrap"><div class="section-heading"><div><p class="eyebrow">A closer look</p><h2>Design evidence.</h2></div></div><div class="figure-grid">{p.figures.map(f=><figure><a href={url(f.src)} aria-label={`Open full size: ${f.alt}`}><img src={url(f.src)} alt={f.alt} width="1200" height="900" loading="lazy"/></a><figcaption>{f.caption}</figcaption></figure>)}</div></section>}{related.length>0&&<section class="related wrap"><p class="eyebrow">Connected coursework</p>{related.map(c=><a class="related-link" href={url(`coursework/${c.id}/`)}><span>{c.data.code}</span>{c.data.title}<b aria-hidden="true">↗</b></a>)}</section>}</Base>
