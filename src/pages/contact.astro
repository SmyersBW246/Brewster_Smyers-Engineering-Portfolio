---
// Contact page: email, LinkedIn and resume download.
import Base from '../layouts/Base.astro';
import { url, email, linkedin } from '../lib/urls';

// Phone number shown on this page, and the same number in dialing form for the tap-to-call link.
const phone = '781-513-7141';
const phoneLink = '+17815137141';
---
<Base title="Contact | Brewster Smyers">
  <section class="contact-page wrap">
    <p class="eyebrow">Let’s connect</p>
    <h1>Good work starts<br/>with a <span>conversation.</span></h1>
    <p class="lead">I’m interested in Summer 2027 engineering internships and opportunities to learn from people working in mechanical design, manufacturing, construction, engineering consulting and aerospace.</p>

    <div class="contact-links">
      <a href={`mailto:${email}`}>
        <small>Email</small>
        <span>{email}</span>
        <b aria-hidden="true">↗</b>
      </a>
      <a href={`tel:${phoneLink}`}>
        <small>Phone</small>
        <span>{phone}</span>
        <b aria-hidden="true">↗</b>
      </a>
      <a href={linkedin}>
        <small>LinkedIn</small>
        <span>Connect with Brewster</span>
        <b aria-hidden="true">↗</b>
      </a>
      <a href={url('resume/Brewster_Smyers_Resume.pdf')}>
        <small>Background</small>
        <span>Download my resume</span>
        <b aria-hidden="true">↓</b>
      </a>
    </div>

    <p class="muted">Bucknell University · Lewisburg, PA<br/>Home: Marblehead, MA</p>
  </section>
</Base>
