---
// Brewster's Desk page. The wording lives in src/data/desk; this file only arranges it.
import Base from '../../layouts/Base.astro';
import { intro, modes, edition, email, rules, unknowns, ending } from '../../data/desk';
import { url } from '../../lib/urls';
---
<Base title="Brewster's Desk | Brewster Smyers" description="Brewster's Desk, a personal AI dashboard built by Bucknell Mechanical Engineering student Brewster Smyers: daytime, sleep and night modes, The 7 AM Edition newsletter, and email screening.">
  {/* Opening, with links that jump to each part of the page */}
  <section class="page-heading learn-heading wrap">
    <p class="eyebrow">Learning with AI / Building with it</p>
    <h1>A desk that works<br/><span>while I sleep.</span></h1>
    <p class="lead">{intro}</p>
    <nav class="story-contents desk-contents" aria-label="On this page">
      {modes.map((m) => <a href={`#${m.id}`}>{m.label}</a>)}
      <a href="#edition">The 7 AM Edition</a>
      <a href="#email">Email screening</a>
      <a href="#unknowns">What’s still unknown</a>
    </nav>
  </section>

  {/* One section per dashboard mode. Every second one is mirrored; all but "day" get the dark frame. */}
  {modes.map((m, i) => (
    <section
      id={m.id}
      class={`section desk-mode wrap${i % 2 ? ' is-flipped' : ''}${m.id !== 'day' ? ' is-dark' : ''}`}
      aria-labelledby={`${m.id}-title`}
    >
      <figure class="desk-shot">
        <img src={url(m.image)} alt={m.alt} loading={i ? 'lazy' : 'eager'} width="800" height="600"/>
        <figcaption>{m.caption}</figcaption>
      </figure>
      <div class="story-copy">
        <p class="eyebrow"><span class="learn-number">0{i + 1}</span>{m.label} / {m.time}</p>
        <h2 id={`${m.id}-title`}>{m.title}</h2>
        {m.body.map((p) => <p>{p}</p>)}
      </div>
    </section>
  ))}

  {/* The 7 AM Edition: lead paragraph, steps and a closing note */}
  <section id="edition" class="section desk-edition wrap" aria-labelledby="edition-title">
    <div class="story-copy">
      <p class="eyebrow">The morning paper</p>
      <h2 id="edition-title">The 7 AM <span>Edition.</span></h2>
      <p>{edition.lead}</p>
    </div>
    <ol class="learn-rule-list desk-steps">
      {edition.steps.map(([title, body]) => (
        <li>
          <strong>{title}</strong>
          <p>{body}</p>
        </li>
      ))}
    </ol>
    <p class="desk-note">{edition.note}</p>
  </section>

  {/* Email screening, with the can / can't list */}
  <section id="email" class="section learn-limits wrap" aria-labelledby="email-title">
    <div class="story-copy">
      <p class="eyebrow">Email screening</p>
      <h2 id="email-title">Three inboxes, <span>screened.</span></h2>
      {email.map((p) => <p>{p}</p>)}
    </div>
    <aside class="learn-aside">
      <p class="eyebrow">What the assistant can and can’t do</p>
      <ul class="desk-cando">
        <li><b>Can</b> read the inbox, flag what matters and summarize newsletters</li>
        <li><b>Can</b> draft a reply when I ask for one</li>
        <li><b>Can’t</b> send, delete or move email on its own</li>
        <li><b>Can’t</b> send a reply until I read it and press Send myself</li>
      </ul>
    </aside>
  </section>

  {/* Numbered design rules */}
  <section class="section learn-rules wrap" aria-labelledby="rules-title">
    <div class="learn-rules-heading">
      <p class="eyebrow">Design rules</p>
      <h2 id="rules-title">How I keep it <span>trustworthy.</span></h2>
    </div>
    <ol class="learn-rule-list">
      {rules.map(([title, body]) => (
        <li>
          <strong>{title}</strong>
          <p>{body}</p>
        </li>
      ))}
    </ol>
  </section>

  {/* Open questions */}
  <section id="unknowns" class="section desk-unknowns wrap" aria-labelledby="unknowns-title">
    <div class="story-copy">
      <p class="eyebrow">Honest about it</p>
      <h2 id="unknowns-title">Promising, and <span>still new.</span></h2>
      {unknowns.map((p) => <p>{p}</p>)}
    </div>
  </section>

  {/* Closing call to action */}
  <section class="story-ending wrap">
    <p class="eyebrow">Looking ahead / Summer 2027</p>
    <h2>Build with it.<br/>Stay in charge.</h2>
    <p>{ending}</p>
    <div class="actions">
      <a class="button" href={url('contact/')}>Get in touch <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={url('learning/')}>How I learn with AI <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>
