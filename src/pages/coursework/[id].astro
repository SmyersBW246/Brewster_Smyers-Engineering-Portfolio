---
// One course page. Astro builds a copy of this page for every file in src/content/coursework.
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/urls';
import katex from 'katex';

// Tells Astro which pages to build: one per course, at /coursework/<file name>/.
export async function getStaticPaths() {
  return (await getCollection('coursework')).map((course) => ({
    params: { id: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const c = course.data;
const { Content } = await render(course);

// Projects listed in this course's "relatedProjects" field.
const projects = (await getCollection('projects')).filter((p) => c.relatedProjects.includes(p.id));
---
<Base title={`${c.code}: ${c.title} | Brewster Smyers`} description={c.summary}>
  <section class="course-heading wrap">
    <a class="back-link" href={url('coursework/')}>← Coursework + notes</a>
    <p class="eyebrow">{c.code} / {c.category}</p>
    <h1>{c.title}<span>.</span></h1>
    <p class="lead">{c.summary}</p>
    <div class="course-meta">
      <span>{c.enrollmentStatus || 'Course status requires confirmation'}</span>
      <a href={c.catalog}>Bucknell catalog · {c.catalogYear} ↗</a>
    </div>
  </section>

  <section class="course-reading wrap">
    {/* Side menu that jumps to each part of the note */}
    <aside class="reading-nav">
      <p class="eyebrow">In this note</p>
      <a href="#principles">Principles + methods</a>
      {c.equations.length > 0 && <a href="#equations">Governing equations</a>}
      {c.connection && <a href="#connections">My project connection</a>}
      <a href="#sources">Sources</a>
    </aside>

    <div>
      {/* The written note from the course's .md file */}
      <article id="principles" class="prose">
        <Content/>
      </article>

      {/* Equation cards. A note may open with a bold lead-in written as **like this**. */}
      {c.equations.length > 0 && (
        <section id="equations" class="equations">
          <p class="eyebrow">Reference toolkit</p>
          <h2>Governing equations.</h2>
          {c.equations.map((eq, i) => (
            <div class="equation">
              <h3><span>{String(i + 1).padStart(2, '0')}</span>{eq.title}</h3>
              <div class="math" set:html={katex.renderToString(eq.latex, { displayMode: true, throwOnError: true, strict: 'ignore' })}/>
              <div class="equation-note">
                {eq.note.split(/\n\n+/).map((note) => {
                  const m = note.match(/^\*\*(.+?)\*\*\s*([\s\S]*)$/);
                  return <p>{m ? <><strong>{m[1]}</strong> {m[2]}</> : note}</p>;
                })}
              </div>
            </div>
          ))}
        </section>
      )}

      {c.figures.map((f) => (
        <figure class="course-figure">
          <img src={url(f.src)} alt={f.alt} width="1000" height="600" loading="lazy"/>
          <figcaption>{f.caption}</figcaption>
        </figure>
      ))}

      {/* How the course ties to Brewster's own projects */}
      {c.connection && (
        <section id="connections" class="connection">
          <p class="eyebrow">Applied learning</p>
          <h2>My project connection.</h2>
          <p>{c.connection}</p>
          {projects.map((p) => (
            <a class="related-link" href={url(`projects/${p.id}/`)}>{p.data.shortTitle}<b aria-hidden="true">↗</b></a>
          ))}
        </section>
      )}

      <section id="sources" class="sources">
        <h2>Sources + scope.</h2>
        <p>Subject explanations and illustrative examples are separate from personal project results. The official catalog establishes curriculum scope; it does not verify my enrollment or individual experience.</p>
        <ul>
          {c.sources.map((s) => <li><a href={s.url}>{s.title} ↗</a></li>)}
        </ul>
      </section>
    </div>
  </section>
</Base>
