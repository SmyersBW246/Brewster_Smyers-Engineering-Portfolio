---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';import {url} from '../../lib/urls';
const courses=(await getCollection('coursework')).sort((a,b)=>a.data.order-b.data.order||a.data.code.localeCompare(b.data.code));const categories=[...new Set(courses.map(c=>c.data.category))];
---
<Base title="Coursework + Engineering Notes | Brewster Smyers"><section class="page-heading wrap"><p class="eyebrow">Engineering foundations</p><h1>Understand it.<br/><span>Then apply it.</span></h1><p>Principles, equations and worked examples drawn from Bucknell’s published course scope, with personal project connections where documented.</p><div class="note">These subject notes do not establish course completion. Enrollment and term are identified on each page where supported; the remaining course statuses need confirmation.</div></section><section class="wrap section course-index"><label class="search-label" for="course-search">Find a subject or course</label><input id="course-search" type="search" placeholder="Try aircraft, MATLAB, or MECH 355"/><p id="course-count" class="muted" aria-live="polite">{courses.length} subject notes</p>{categories.map(category=><section class="course-group" data-course-group><h2>{category}</h2><div>{courses.filter(c=>c.data.category===category).map(c=><a data-course data-search={`${c.data.code} ${c.data.title} ${c.data.category} ${c.data.summary}`.toLowerCase()} href={url(`coursework/${c.id}/`)} class="course-row"><span class="course-code">{c.data.code}</span><div><h3>{c.data.title}</h3><p>{c.data.summary}</p><small>{c.data.documented?'Documented project connection':'Catalog-based subject note'}</small></div><span aria-hidden="true">↗</span></a>)}</div></section>)}</section></Base>
<script>const search=document.getElementById('course-search') as HTMLInputElement;search?.addEventListener('input',()=>{const q=search.value.toLowerCase().trim();let count=0;document.querySelectorAll('[data-course]').forEach(item=>{const show=item.getAttribute('data-search')?.includes(q);(item as HTMLElement).hidden=!show;if(show)count++});document.querySelectorAll('[data-course-group]').forEach(group=>(group as HTMLElement).hidden=!group.querySelector('[data-course]:not([hidden])'));const output=document.getElementById('course-count');if(output)output.textContent=`${count} subject note${count===1?'':'s'}`});</script>
