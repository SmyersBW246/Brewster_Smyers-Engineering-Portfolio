---
import Base from '../layouts/Base.astro';import ProjectCard from '../components/ProjectCard.astro';import { getCollection } from 'astro:content';import { url } from '../lib/urls';
const projects=(await getCollection('projects')).filter(p=>p.data.featured).sort((a,b)=>a.data.order-b.data.order).slice(0,4);
---
<Base>
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> Bucknell University · Class of 2028</p><h1>Ideas into<br/><span>engineered</span><br/>reality.</h1><p class="hero-intro">I’m Brewster Smyers, a mechanical engineering student who likes turning a model into something I can build, test and improve.</p><div class="actions"><a class="button" href="#selected-work">Explore my work <span aria-hidden="true">↘</span></a><a class="text-link" href={url('about/')}>Meet Brewster <span aria-hidden="true">↗</span></a></div></div><figure class="hero-figure"><div class="hero-image"><img src={url('images/chair-cad.webp')} alt="Brewster’s SolidWorks model of an oversized outdoor chair, with braced timber frame" width="1052" height="1046" fetchpriority="high"/><span class="image-tag">01 / DESIGN + BUILD</span></div><figcaption><span>Outdoor Landmark Chair</span><span>My original SolidWorks model</span></figcaption></figure></section>
<div class="discipline-strip"><div class="wrap"><span>Design with purpose.</span><span>SolidWorks / MATLAB</span><span>Analysis / Fabrication</span><span>Curiosity / Iteration</span></div></div>
<section id="selected-work" class="section wrap"><div class="section-heading"><div><p class="eyebrow">Selected work / 01–04</p><h2>A closer look<br/>at the work.</h2></div><a class="text-link" href={url('projects/')}>All projects <span aria-hidden="true">↗</span></a></div><div class="project-grid">{projects.map((p,i)=><ProjectCard project={p} number={i+1}/>)}</div></section>
<section class="foundation wrap"><div><p class="eyebrow">Theory, put to work</p><h2>The principles<br/>behind the projects.</h2><p>From buoyancy and fluid flow to aircraft performance and manufacturing, these notes connect engineering methods with their practical uses.</p><a class="text-link" href={url('coursework/')}>Explore coursework <span aria-hidden="true">↗</span></a></div><div class="foundation-list"><a href={url('coursework/mech-355/')}><span>01</span> Manufacturing Processes <b aria-hidden="true">↗</b></a><a href={url('coursework/mech-438/')}><span>02</span> Aircraft Design <b aria-hidden="true">↗</b></a><a href={url('coursework/mech-313/')}><span>03</span> Fluid Dynamics <b aria-hidden="true">↗</b></a></div></section>
<section class="closing wrap"><p class="eyebrow">Next chapter</p><h2>Ready to build<br/>what comes next.</h2><div><p>I’m pursuing Summer 2027 engineering internships in mechanical design, manufacturing, aerospace and product development.</p><a class="button" href={url('contact/')}>Get in touch <span aria-hidden="true">↗</span></a></div></section>
</Base>
