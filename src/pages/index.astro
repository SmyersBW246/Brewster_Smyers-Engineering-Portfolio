---
import Base from '../layouts/Base.astro';import ProjectCard from '../components/ProjectCard.astro';import { getCollection } from 'astro:content';import { url } from '../lib/urls';
const projects=(await getCollection('projects')).filter(p=>p.data.featured).sort((a,b)=>a.data.order-b.data.order).slice(0,4);
---
<Base>
<section class="hero wrap first-impression"><div class="hero-copy"><p class="eyebrow">Bucknell University · Mechanical Engineering · 2028</p><h1>Brewster<br/><span>Smyers.</span></h1><p class="hero-statement">I like building things.<br/>And figuring out how they work.</p><p class="hero-intro">From a full-size timber chair to aircraft models in MATLAB, I’m learning how to connect a design with the calculations and work behind it.</p><p class="availability">Seeking a Summer 2027 engineering internship.</p><div class="actions"><a class="button" href="#selected-work">Explore my work <span aria-hidden="true">↘</span></a><a class="text-link" href={url('about/')}>Meet Brewster <span aria-hidden="true">↗</span></a></div></div><figure class="hero-figure"><div class="hero-image"><img src={url('images/chair-cad.webp')} alt="My SolidWorks model of the oversized timber chair I designed and built" width="1052" height="1046" fetchpriority="high"/><span class="image-tag">DESIGNED IN CAD. BUILT BY HAND.</span></div><figcaption><span>Outdoor Landmark Chair</span><span>Independent build · 2 days · ~$1,000</span></figcaption></figure></section>
<section id="selected-work" class="section wrap selected-section"><div class="section-heading"><div><p class="eyebrow">Selected work / 01–04</p><h2>Built, modeled,<br/>worked through.</h2></div><a class="text-link" href={url('projects/')}>All projects <span aria-hidden="true">↗</span></a></div><div class="project-grid">{projects.map((p,i)=><ProjectCard project={p} number={i+1}/>)}</div></section>
<section class="home-personal wrap"><img src={url('images/portrait.webp')} alt="Brewster Smyers" width="1280" height="1915" loading="lazy"/><div><p class="eyebrow">Beyond the projects</p><h2>New England roots.<br/>Usually outside.</h2><p>Skiing, starting an Ultimate Frisbee team, and roughly 200 miles on the Appalachian Trail. There’s a little more to my story than CAD.</p><a class="text-link" href={url('about/')}>A little about me <span aria-hidden="true">↗</span></a></div></section>
<section class="foundation wrap"><div><p class="eyebrow">Theory, put to work</p><h2>The principles<br/>behind the projects.</h2><p>From buoyancy and fluid flow to aircraft performance and manufacturing, these notes connect engineering methods with their practical uses.</p><a class="text-link" href={url('coursework/')}>Explore coursework <span aria-hidden="true">↗</span></a></div><div class="foundation-list"><a href={url('coursework/mech-355/')}><span>01</span> Manufacturing Processes <b aria-hidden="true">↗</b></a><a href={url('coursework/mech-438/')}><span>02</span> Aircraft Design <b aria-hidden="true">↗</b></a><a href={url('coursework/mech-313/')}><span>03</span> Fluid Dynamics <b aria-hidden="true">↗</b></a></div></section>
<section class="closing wrap"><p class="eyebrow">Next chapter</p><h2>Ready to build<br/>what comes next.</h2><div><p>I’m pursuing Summer 2027 engineering internships in mechanical design, manufacturing, aerospace and product development.</p><a class="button" href={url('contact/')}>Get in touch <span aria-hidden="true">↗</span></a></div></section>
</Base>
