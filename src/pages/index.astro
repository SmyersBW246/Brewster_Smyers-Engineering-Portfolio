---
// Home page, A+ design preview.
// Order: hero (statement + featured project), quick facts, tools band, six selected projects,
// every other project ("More projects"), the three themes with proofs, closing call to action.
// To change the tiles, edit "picks". Every project not in "picks" appears under "More projects".
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/urls';

const themes = [
  {
    label: 'Build',
    title: 'I build things.',
    line: 'If I design it, I want to see it built and in use.',
    proofs: [
      ['Outdoor chair', 'Designed in SolidWorks, then built by myself in 2 days for about $1,000.', 'projects/outdoor-landmark-chair/'],
      ['Injection mold', 'Machined in aluminum on a Haas mill from my own G-code.', 'projects/ack-coaster-mold/'],
      ['Backyard ski jump', 'Built in about 6 hours in eighth grade, then improved three ways.', 'projects/backyard-ski-jump/'],
    ],
  },
  {
    label: 'Ask why',
    title: 'I ask why it works.',
    line: 'I don’t trust a number until I know where it came from.',
    proofs: [
      ['Pipe bracket', 'The FEA showed a 376 MPa peak. I checked by hand, got 140 MPa and traced the peak to a sharp corner.', 'projects/pipe-brace-bracket/'],
      ['Bronze rook', 'Cast it, then measured it: 3.36% narrower and about 14% lighter than my CAD.', 'projects/bronze-cast-rook/'],
      ['Biplane model', 'A MATLAB model that ties geometry to lift, drag, fuel and trim.', 'projects/aerobatic-biplane/'],
    ],
  },
  {
    label: 'Lead',
    title: 'I lead the team.',
    line: 'I make sure everyone knows what they own, then we get it done.',
    proofs: [
      ['Fluids project', 'Team lead on a team of six, designing an underwater vehicle hull and the water tunnel to test it.', 'projects/autonomous-underwater-vehicle/'],
      ['Movember triathlon', 'Organizing an indoor fundraiser at Bucknell: venue, safety plan, schedule and volunteers.', 'about/#bucknell'],
      ['Ultimate Frisbee', 'Founded the team at St. Paul’s School.', 'about/#st-pauls'],
    ],
  },
];

// The six tiles in the main grid, in order. These are file names in src/content/projects.
const picks = [
  'micro-drone-chassis',
  'ack-coaster-mold',
  'cam-tutor-fusion-addin',
  'autonomous-underwater-vehicle',
  'aerobatic-biplane',
  'outdoor-landmark-chair',
];
const all = (await getCollection('projects', (p) => !p.data.hidden)).sort((a, b) => a.data.order - b.data.order);
const byId = new Map(all.map((p) => [p.id, p]));
const projects = picks.map((id) => byId.get(id)).filter(Boolean);
const more = all.filter((p) => !picks.includes(p.id));
const lead = byId.get('micro-drone-chassis');
---
<Base>
  {/* Opening: statement and buttons on the left, featured project on the right */}
  <section class="ap-hero wrap">
    <div class="ap-hero-copy">
      <p class="eyebrow">Mechanical Engineering · Bucknell 2028</p>
      <h1>I build.<br/>I ask <em>why.</em><br/>I lead.</h1>
      <p class="ap-statement">I like taking an idea from a sketch, leading the team that builds it, and ending with something people actually use.</p>
      <p class="ap-avail">Seeking a Summer 2027 mechanical engineering internship.</p>
      <div class="ap-buttons">
        <a class="button" href="#selected-work">See my projects <span aria-hidden="true">↓</span></a>
        <a class="button ghost" href={url('resume/')}>Résumé <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    {lead && (
      <a class="ap-sheet" href={url(`projects/${lead.id}/`)} aria-label={`Featured project: ${lead.data.shortTitle}`}>
        <span class="ap-sticker">Summer 2027</span>
        <div class="ap-sheet-img">
          <img src={url(lead.data.hero)} alt={lead.data.heroAlt} width="1400" height="1867" fetchpriority="high"/>
        </div>
        <div class="ap-title-block">
          <div><small>Featured</small><strong>Molded <span>in carbon</span></strong></div>
          <div><small>{lead.data.shortTitle}</small><p>The first chopped-carbon chassis, pressed in my own 3-part printed compression mold.</p></div>
          <div class="ap-read">Read it <span aria-hidden="true">→</span></div>
        </div>
      </a>
    )}
  </section>

  {/* Quick facts */}
  <section class="ap-facts" aria-label="At a glance">
    <div class="wrap">
      <div><small>Degree</small><p>B.S. Mechanical Engineering, with minors in Mathematics and Business Analytics. Bucknell University, May 2028</p></div>
      <div><small>Looking for</small><p>A Summer 2027 internship in mechanical design or manufacturing</p></div>
      <div><small>Tools</small><p>SolidWorks (CSWA), Mastercam, MATLAB, Excel, Python and Arduino</p></div>
    </div>
  </section>

  <div class="ap-band"><div class="wrap">
    <span>SolidWorks (CSWA)</span><span>Mastercam</span><span>MATLAB</span><span>Excel</span><span>Python</span><span>Arduino</span><span>CNC · Molding · FEA</span>
  </div></div>

  {/* Six selected projects */}
  <section id="selected-work" class="section wrap ap-work">
    <div class="section-heading">
      <div>
        <span class="ap-tag">The work</span>
        <h2>Selected projects</h2>
      </div>
      <a class="text-link" href={url('projects/')}>All {all.length} projects <span aria-hidden="true">↗</span></a>
    </div>
    <div class="project-grid ap-grid">
      {projects.map((p, i) => <ProjectCard project={p} number={i + 1}/>)}
    </div>
  </section>

  {/* Every other project, so nothing is hidden */}
  <section id="more-projects" class="wrap ap-more" aria-labelledby="more-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Also on the site</p>
        <h2 id="more-title">More projects</h2>
      </div>
      <a class="text-link" href={url('projects/')}>See the full Projects page <span aria-hidden="true">↗</span></a>
    </div>
    <div class="project-grid ap-grid ap-grid-compact">
      {more.map((p, i) => <ProjectCard project={p} number={projects.length + i + 1} compact/>)}
    </div>
  </section>

  {/* Three themes, each with proof */}
  <section class="ap-themes wrap" aria-label="Three things about me">
    {themes.map((t, i) => (
      <article class="ap-theme" aria-labelledby={`theme-${i + 1}`}>
        <p class="eyebrow">0{i + 1} / {t.label}</p>
        <h2 id={`theme-${i + 1}`}>{t.title}</h2>
        <p class="ap-theme-line">{t.line}</p>
        <ul>
          {t.proofs.map(([what, detail, href]) => (
            <li>
              <a href={url(href)}>
                <strong>{what} <span aria-hidden="true">↗</span></strong>
                <span>{detail}</span>
              </a>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  {/* Closing call to action */}
  <section class="closing wrap">
    <p class="eyebrow">Summer 2027</p>
    <h2>Ready to build<br/>what comes next.</h2>
    <div>
      <p>I’m pursuing Summer 2027 engineering internships in mechanical design, manufacturing, construction and engineering consulting.</p>
      <div class="ap-buttons">
        <a class="button" href={url('contact/')}>Get in touch <span aria-hidden="true">↗</span></a>
        <a class="button ghost" href={url('about/')}>About me <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ap-hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    padding-block: 60px 76px;
    align-items: center;
  }

  .ap-hero .eyebrow {
    margin-bottom: 18px;
  }

  .ap-hero h1 {
    font-size: clamp(3.4rem, 6.4vw, 6rem);
    line-height: .98;
    letter-spacing: -.06em;
    margin-bottom: 24px;
  }

  .ap-hero h1 em {
    font-style: normal;
    background: linear-gradient(transparent 58%, var(--sand) 58%, var(--sand) 92%, transparent 92%);
    padding-inline: .06em;
  }

  .ap-statement {
    font-size: 1.08rem;
    line-height: 1.55;
    max-width: 34ch;
    margin-bottom: 0;
  }

  .ap-avail {
    margin: 14px 0 0;
    font-size: .92rem;
    font-weight: 800;
    color: var(--accent);
  }

  .ap-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 30px;
  }

  .ap-sheet {
    display: block;
    position: relative;
    border: 2px solid var(--ink);
    background: var(--white);
    box-shadow: 8px 8px 0 var(--ink);
  }

  .ap-sticker {
    position: absolute;
    top: -14px;
    right: 22px;
    z-index: 2;
    background: var(--accent);
    color: #fff;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 7px 14px;
    border: 2px solid var(--ink);
    transform: rotate(2.5deg);
  }

  .ap-sheet-img {
    aspect-ratio: 3 / 2;
    background: var(--blue);
    overflow: hidden;
  }

  .ap-sheet-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 52%;
  }

  .ap-title-block {
    display: grid;
    grid-template-columns: auto 1fr auto;
    border-top: 2px solid var(--ink);
    background: var(--blue);
  }

  .ap-title-block > div {
    padding: 14px 18px;
  }

  .ap-title-block > div + div {
    border-left: 2px solid var(--ink);
  }

  .ap-title-block small {
    display: block;
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 5px;
  }

  .ap-title-block strong {
    font-family: var(--display);
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: -.04em;
    white-space: nowrap;
  }

  .ap-title-block strong span {
    font-size: .85rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0;
  }

  .ap-title-block p {
    font-size: .9rem;
    line-height: 1.45;
    margin: 0;
  }

  .ap-read {
    display: flex;
    align-items: center;
    font-weight: 800;
    font-size: .85rem;
    color: var(--accent);
    background: var(--white);
  }

  .ap-facts {
    border-block: 2px solid var(--ink);
    background: var(--white);
  }

  .ap-facts .wrap {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .ap-facts .wrap > div {
    padding: 22px 24px 24px;
    border-left: 2px solid var(--ink);
  }

  .ap-facts .wrap > div:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .ap-facts small {
    display: block;
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 7px;
  }

  .ap-facts p {
    font-size: .92rem;
    font-weight: 700;
    line-height: 1.5;
    margin: 0;
  }

  .ap-band {
    background: var(--ink);
    color: var(--paper);
  }

  .ap-band .wrap {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 28px;
    padding-block: 13px;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .ap-band span:nth-child(odd) {
    color: var(--sand);
  }

  .ap-work {
    padding-block: 80px 40px;
  }

  .ap-tag {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 5px 12px;
    border: 2px solid var(--ink);
    transform: rotate(-2deg);
    margin-bottom: 14px;
  }

  .ap-work h2,
  .ap-more h2 {
    font-size: clamp(2rem, 3vw, 2.8rem);
    letter-spacing: -.05em;
  }

  .ap-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px 28px;
  }

  .ap-grid-compact {
    gap: 28px 24px;
  }

  .ap-more {
    padding-block: 36px 80px;
  }

  .ap-themes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 44px;
    padding-block: 70px 30px;
    border-top: 2px solid var(--ink);
  }

  .ap-theme h2 {
    font-size: clamp(1.8rem, 2.6vw, 2.4rem);
    letter-spacing: -.05em;
  }

  .ap-theme .eyebrow {
    margin-bottom: 16px;
  }

  .ap-theme-line {
    font-family: var(--display);
    font-size: 1.02rem;
    letter-spacing: -.02em;
    line-height: 1.4;
    color: var(--accent);
    margin-top: 12px;
    min-height: 2.8em;
  }

  .ap-theme ul {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    border-top: 3px solid var(--ink);
  }

  .ap-theme li a {
    display: block;
    padding: 15px 0 16px;
    border-bottom: 1px solid var(--line);
  }

  .ap-theme li strong {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: .86rem;
  }

  .ap-theme li a > span {
    display: block;
    margin-top: 5px;
    font-size: .82rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .ap-theme li a:hover strong {
    color: var(--accent);
  }

  @media (max-width: 980px) {
    .ap-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .ap-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ap-themes {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }

    .ap-theme-line {
      min-height: 0;
    }
  }

  @media (max-width: 720px) {
    .ap-hero {
      padding-block: 40px 56px;
    }

    .ap-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .ap-facts .wrap {
      grid-template-columns: minmax(0, 1fr);
    }

    .ap-facts .wrap > div,
    .ap-facts .wrap > div:first-child {
      padding: 16px 0;
      border-left: 0;
    }

    .ap-facts .wrap > div + div {
      border-top: 2px solid var(--ink);
    }

    .ap-title-block {
      grid-template-columns: minmax(0, 1fr);
    }

    .ap-title-block > div + div {
      border-left: 0;
      border-top: 2px solid var(--ink);
    }

    .ap-sheet {
      box-shadow: 5px 5px 0 var(--ink);
    }
  }
</style>
