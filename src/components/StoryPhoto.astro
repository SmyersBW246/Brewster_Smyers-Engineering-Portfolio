---
import {photos} from '../data/photos';
import {url} from '../lib/urls';
const {name,caption,priority=false,class:className=''} = Astro.props;
const photo=photos[name as keyof typeof photos];
const widths=photo.sizes;
const largest=widths[widths.length-1];
---
<figure class:list={['story-photo',className]}>
<img src={url(`images/personal/${name}-${largest}.webp`)} srcset={widths.map(w=>`${url(`images/personal/${name}-${w}.webp`)} ${w}w`).join(', ')} sizes="(max-width: 720px) calc(100vw - 44px), (max-width: 1000px) 50vw, 650px" width={photo.width} height={photo.height} alt={photo.alt} loading={priority?'eager':'lazy'} fetchpriority={priority?'high':undefined}/>
{caption && <figcaption>{caption}</figcaption>}
</figure>
